# ==============================================================================
# Job Tracker Application - Environment Configuration Template
# ==============================================================================

# PostgreSQL Database Configuration
# In production, point to AWS RDS instance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=job_tracker
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_tracker

# JWT Authentication
# Replace with a strong random secret in production
JWT_SECRET=super_secret_jwt_key_job_tracker_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AWS S3 Settings
# When running on AWS EC2, the instance's IAM Role credentials are used automatically.
# Leave AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY blank on EC2.
AWS_S3_BUCKET_NAME=job-tracker-resumes
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=

# CORS Origins (comma-separated origins)
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:3000

# Local Storage Mock (set to true to run fully offline without AWS/MinIO)
USE_LOCAL_S3_MOCK=false
