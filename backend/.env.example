# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_tracker

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_job_tracker_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AWS S3 Settings (IAM Role is used automatically on EC2 if access keys are left empty)
AWS_S3_BUCKET_NAME=job-tracker-resumes
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=

# CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# Optional: set to true to test locally without AWS/MinIO
USE_LOCAL_S3_MOCK=false
